  "sources": {
    "_설명": "API 주소와 응답 항목 이름. 점검 스크립트(probe) 결과를 보고 맞춥니다. fields의 각 항목은 후보 이름 목록이며, 응답에 있는 첫 번째 이름을 씁니다.",
    "population": {
      "key_env": "DATA_GO_KR_KEY",
      "url": "https://apis.data.go.kr/1741000/stdgPpltnHhStus/selectStdgPpltnHhStus",
      "params": {
        "type": "JSON",
        "lv": "2",
        "regSeCd": "1",
        "numOfRows": "100",
        "pageNo": "1"
      },
      "fields": {
        "sgg_name": [
          "sggNm",
          "signguNm",
          "sigunguNm",
          "시군구명"
        ],
        "total": [
          "totNmprCnt",
          "totPpltnCnt",
          "tot_ppltn",
          "총인구수"
        ],
        "hh": [
          "hhCnt",
          "hhldCnt",
          "세대수"
        ],
        "male": [
          "maleNmprCnt",
          "malePpltnCnt",
          "남자인구수"
        ],
        "female": [
          "femlNmprCnt",
          "femalePpltnCnt",
          "여자인구수"
        ]
      },
      "_메모": "요청 주소 끝의 오퍼레이션 이름은 활용신청 후 명세에서 확인 필요"
    },
    "dong_population": {
      "key_env": "DATA_GO_KR_KEY",
      "url": "https://apis.data.go.kr/1741000/stdgPpltnHhStus/selectStdgPpltnHhStus",
      "params": {
        "type": "JSON",
        "lv": "3",
        "regSeCd": "1",
        "numOfRows": "100",
        "pageNo": "1"
      },
      "fields": {
        "dong_name": [
          "admmNm",
          "adongNm",
          "행정동명",
          "stdgNm",
          "법정동명"
        ],
        "total": [
          "totNmprCnt",
          "totPpltnCnt",
          "총인구수"
        ],
        "hh": [
          "hhCnt",
          "hhldCnt",
          "세대수"
        ]
      }
    },
    "age": {
      "_설명": "생산연령(15~64세)·고령(65세 이상) 비율을 '정확한 값'으로 계산하기 위한 원천. 추정은 하지 않습니다. mode가 가리키는 원천을 먼저 쓰고, 실패하면 다른 쪽을 시도합니다. 둘 다 안 되면 두 지표는 화면에 나오지 않습니다.",
      "mode": "kosis",
      "kosis": {
        "_설명": "KOSIS 5세 단위 시·군 주민등록인구(월). 통계표 ID는 키 발급 후 점검에서 확인",
        "key_env": "KOSIS_KEY",
        "key_param": "apiKey",
        "url": "https://kosis.kr/openapi/Param/statisticsParameterData.do",
        "params": {
          "method": "getList",
          "format": "json",
          "jsonVD": "Y",
          "orgId": "101",
          "tblId": "DT_1B04005N",
          "itmId": "ALL",
          "objL1": "ALL",
          "objL2": "ALL",
          "prdSe": "M",
          "newEstPrdCnt": "1"
        },
        "region_code_prefix": [
          "51",
          "32"
        ],
        "meta_url": "https://kosis.kr/openapi/statisticsData.do"
      },
      "mois": {
        "_설명": "행안부 지역별(법정동) 성별 연령별 주민등록 인구수(1세 단위, 공공데이터포털 파일데이터→자동변환 API). 요청 주소는 활용신청 후 채움",
        "key_env": "DATA_GO_KR_KEY",
        "key_param": "serviceKey",
        "url": "",
        "params": {
          "page": "1",
          "perPage": "10000",
          "returnType": "JSON"
        },
        "fields": {
          "sgg_name": [
            "시군구명",
            "sggNm"
          ],
          "sido_name": [
            "시도명",
            "ctpvNm"
          ]
        }
      }
    },
    "finance": {
      "key_env": "LOFIN_KEY",
      "url": "https://www.lofin365.go.kr/lf/hub/DCFCE",
      "params": {
        "Type": "json",
        "pIndex": "1",
        "pSize": "1000"
      },
      "fields": {
        "region_name": [
          "laf_hg_nm",
          "wdr_sfrnd_nm",
          "lafNm",
          "자치단체명",
          "laf_nm"
        ],
        "year": [
          "fyr",
          "accnut_year",
          "회계연도"
        ],
        "fin_indep": [
          "rate2",
          "fnc_idp_rt",
          "fisc_indep_rate",
          "재정자립도"
        ],
        "sido_name": [
          "wa_laf_hg_nm"
        ]
      },
      "_설명": "지방재정365 재정자립도(당초) — 순위는 이 값으로 매깁니다. 요청 주소는 활용신청 후 상세 페이지에서 채움 · 지방재정365가 해외(GitHub) 접속을 막아, 국내 PC에서 받은 파일 manual/lofin_<코드>.json을 씁니다. rate2 = 세입과목 개편 후 재정자립도(공식 값)",
      "key_param": "Key",
      "kr_relay": true,
      "key_env_alt": "LOFIN_KEY_FINAL"
    },
    "finance_final": {
      "key_env": "LOFIN_KEY_FINAL",
      "url": "https://www.lofin365.go.kr/lf/hub/JFIED",
      "params": {
        "Type": "json",
        "pIndex": "1",
        "pSize": "1000"
      },
      "fields": {
        "region_name": [
          "laf_hg_nm",
          "wdr_sfrnd_nm",
          "lafNm",
          "자치단체명",
          "laf_nm"
        ],
        "year": [
          "fyr",
          "accnut_year",
          "회계연도"
        ],
        "fin_indep": [
          "rate2",
          "fnc_idp_rt",
          "fisc_indep_rate",
          "재정자립도"
        ],
        "sido_name": [
          "wa_laf_hg_nm"
        ]
      },
      "_설명": "지방재정365 재정자립도(최종) — 순위에는 쓰지 않고, 같은 해 당초와 비교만 합니다(연말 추경 반영 후). 요청 주소는 활용신청 후 채움 · 지방재정365가 해외(GitHub) 접속을 막아, 국내 PC에서 받은 파일 manual/lofin_<코드>.json을 씁니다. rate2 = 세입과목 개편 후 재정자립도(공식 값)",
      "key_param": "Key",
      "kr_relay": true
    },
    "budget_accounts": {
      "url": "https://www.lofin365.go.kr/lf/hub/ARBGT",
      "key_env": "LOFIN_KEY",
      "key_env_alt": "LOFIN_KEY_FINAL",
      "params": {
        "Type": "json",
        "pIndex": "1",
        "pSize": "1000"
      },
      "key_param": "Key",
      "paging": null,
      "kr_relay": true
    }
